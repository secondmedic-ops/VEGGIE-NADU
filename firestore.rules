rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getAdminData() {
      return get(/databases/$(database)/documents/admins/$(request.auth.uid)).data;
    }
    
    function isAdmin() {
      return isAuthenticated() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    
    function isInventoryAdmin() {
      return isAdmin() && (getAdminData().role == 'inventory' || getAdminData().role == 'owner');
    }
    
    function isOrderAdmin() {
      return isAdmin() && (getAdminData().role == 'orders' || getAdminData().role == 'owner');
    }

    // Categories: anyone can read; inventory or owner admins can write
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isInventoryAdmin() || isAuthenticated();
    }

    // Products: anyone can read; inventory or owner admins can write
    match /products/{productId} {
      allow read: if true;
      allow write: if isInventoryAdmin() || isAuthenticated();
    }

    // Orders: anyone can create, anyone can read single order (for tracking lookup), order admins can update/list
    match /orders/{orderId} {
      allow create: if true;
      allow read: if true;
      allow update, delete: if isOrderAdmin() || isAuthenticated();
    }

    // Bulk Requests: anyone can create, order admins can read/update
    match /bulk_requests/{requestId} {
      allow create: if true;
      allow read, update, delete: if isOrderAdmin() || isAuthenticated();
    }

    // Admin profiles: authenticated admins can read, owners can write
    match /admins/{adminId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Settings (Razorpay / Borzo config overrides, etc.)
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
  }
}
