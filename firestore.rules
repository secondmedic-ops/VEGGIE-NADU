rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Categories: public read, allow write for store management and initial catalog seeding
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if true;
    }

    // Products: public read, allow write for catalog and stock updates
    match /products/{productId} {
      allow read: if true;
      allow write: if true;
    }

    // Orders: customers can create and read orders (tracking), staff can update status & courier details
    match /orders/{orderId} {
      allow read, create: if true;
      allow update, delete: if true;
    }

    // Bulk Requests: customers can submit quote inquiries, staff can review and manage quotes
    match /bulk_requests/{requestId} {
      allow read, create: if true;
      allow update, delete: if true;
    }

    // Admin profiles: staff can access and authenticate
    match /admins/{adminId} {
      allow read, write: if true;
    }

    // Settings (Borzo/Razorpay configuration overrides, store metadata)
    match /settings/{settingId} {
      allow read, write: if true;
    }
  }
}
